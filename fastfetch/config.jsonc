{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#C4A7E7"
    }
  },

  "display": {
    "separator": " "
  },

  "modules": [
    "break",
    "break",

    {
      "type": "title",
      "keyWidth": 10,
      "format": "\u001b[38;2;224;222;244m{user-name}@{host-name}\u001b[0m"
    },

    "break",

    {
      "type": "os",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "Void Linux (ofc)"
    },
    {
      "type": "host",
      "key": "🖥 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "blck's pc"
    },
    {
      "type": "shell",
      "format": "bash",
      "key": ">_",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },
    {
      "type": "wm",
      "format": "KDE Plasma (<3)",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "12th Gen Intel(R) Core(TM) i5-1235U"
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "Intel UHD Graphics"
    },
    {
      "type": "memory",
      "key": "🎟 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "{} {}"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },

    "break",
    "break",
    "break"
  ]
}
